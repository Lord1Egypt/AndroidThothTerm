<!--
  Extra-keys metrics for a SHORT window, which is what landscape on a phone is.
  These are the defaults; values-h500dp supplies the roomier set. The bar is a
  fixed-height sibling of the terminal viewport in activity_term.xml, so every
  dp here is taken directly from the terminal. Keep the two files in step.
-->
<resources>
    <dimen name="extra_keys_view_padding">1dp</dimen>
    <dimen name="extra_keys_row_height">28dp</dimen>
    <dimen name="extra_keys_row_padding_horizontal">3dp</dimen>
    <dimen name="extra_keys_button_height">26dp</dimen>
    <dimen name="extra_keys_button_margin">1dp</dimen>
    <integer name="extra_keys_button_text_sp">10</integer>
</resources>
