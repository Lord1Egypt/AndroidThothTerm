<com.google.android.material.appbar.AppBarLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent">

    <!-- A single, compact bar: brand title, live session subtitle on the
         second line, and New window plus the overflow menu at the end.
         AppCompat constrains and ellipsizes the title/subtitle against the
         menu, so long session labels never wrap or push the actions away. -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        android:theme="@style/ThothTerm.Toolbar.Theme"
        app:contentInsetStartWithNavigation="4dp"
        app:contentInsetEnd="4dp"
        app:popupTheme="?attr/actionBarPopupTheme"
        app:subtitleTextColor="@color/brand_text_muted_dark"
        app:subtitleTextAppearance="@style/ThothTerm.Toolbar.Subtitle"
        app:title="@string/application_terminal"
        app:titleMarginStart="8dp"
        app:titleTextAppearance="@style/ThothTerm.Toolbar.Title"
        app:titleTextColor="@color/brand_white"/>

</com.google.android.material.appbar.AppBarLayout>
