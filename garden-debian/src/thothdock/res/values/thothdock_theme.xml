<!-- ThothDock graphite for floating surfaces (the overflow menu, dialogs).
     AppCompat's dark default is a neutral #303030/#424242; these two styles
     replace the library's of the same names in the ThothDock build only, and
     repeat their other items unchanged. -->
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="BaseAppTheme" parent="Theme.AppCompat">
        <item name="colorPrimary">@color/brand_surface</item>
        <item name="colorPrimaryDark">@color/brand_background</item>
        <item name="colorAccent">@color/brand_accent</item>
        <item name="colorPrimaryLight">@color/brand_surface_light</item>
        <item name="themeTextColor">?android:attr/textColorPrimary</item>
        <item name="android:windowBackground">@color/brand_background</item>
        <item name="android:navigationBarColor" tools:targetApi="21">@color/brand_background</item>
        <item name="android:statusBarColor" tools:targetApi="21">@color/brand_background</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
        <item name="alertDialogTheme">@style/ThothTerm.Dialog</item>
        <item name="colorBackgroundFloating">@color/thothdock_surface_raised</item>
        <item name="android:colorBackgroundFloating" tools:targetApi="23">@color/thothdock_surface_raised</item>
    </style>

    <style name="ThothTerm.Dialog" parent="Theme.AppCompat.Dialog.Alert">
        <item name="colorAccent">@color/brand_accent</item>
        <item name="colorBackgroundFloating">@color/thothdock_surface_raised</item>
        <item name="android:colorBackgroundFloating" tools:targetApi="23">@color/thothdock_surface_raised</item>
    </style>
</resources>
