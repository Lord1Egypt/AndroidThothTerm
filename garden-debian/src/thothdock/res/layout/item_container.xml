<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginTop="10dp"
    android:layout_marginEnd="12dp"
    android:background="@drawable/thothdock_card"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:id="@+id/item_dot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/thothdock_dot"/>

        <TextView
            android:id="@+id/item_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/thothdock_text_primary"
            android:textSize="16sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/item_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="13sp"/>
    </LinearLayout>

    <TextView
        android:id="@+id/item_image"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="middle"
        android:singleLine="true"
        android:textColor="@color/thothdock_kind_image"
        android:textSize="13sp"
        android:typeface="monospace"/>

    <TextView
        android:id="@+id/item_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/thothdock_text_secondary"
        android:textSize="13sp"/>

    <TextView
        android:id="@+id/item_ports"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/thothdock_kind_port"
        android:textSize="13sp"
        android:typeface="monospace"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_toggle"
            style="@style/ThothDockAction"/>

        <Button
            android:id="@+id/btn_restart"
            style="@style/ThothDockAction"
            android:text="@string/containers_restart"/>

        <Button
            android:id="@+id/btn_logs"
            style="@style/ThothDockAction"
            android:text="@string/containers_logs"/>

        <Button
            android:id="@+id/btn_shell"
            style="@style/ThothDockAction"
            android:text="@string/containers_shell"/>

        <Button
            android:id="@+id/btn_delete"
            style="@style/ThothDockAction"
            android:text="@string/containers_delete"
            android:textColor="@color/thothdock_state_error"/>
    </LinearLayout>
</LinearLayout>
