<resources>
    <!-- ThothTerm visual identity. Keep app chrome separate from terminal ANSI colors. -->
    <!-- The app chrome's colour roles. Deliberately neutral grey here: every
         Garden edition overrides each of them from its own approved artwork,
         so an edition that forgot one can never look like another edition. -->
    <color name="brand_background">#121212</color>
    <color name="brand_surface">#1E1E1E</color>
    <color name="brand_surface_light">#2C2C2C</color>
    <color name="brand_accent">#BDBDBD</color>
    <color name="brand_accent_dark">#757575</color>
    <color name="brand_light_background">#F5F5F5</color>
    <color name="brand_light_primary">#424242</color>
    <color name="brand_light_primary_dark">#212121</color>
    <color name="brand_light_primary_light">#616161</color>
    <color name="brand_on_surface">#FFFFFFFF</color>
    <color name="brand_on_surface_muted">#B0B0B0</color>

    <color name="colorvalue_alpha">#FFFFFFFF</color>
    <color name="colorvalue_red">#FFFF0000</color>
    <color name="colorvalue_green">#FF00FF00</color>
    <color name="colorvalue_blue">#FF0000FF</color>

    <!-- Diagnostics log level accents (legible on dark, light, and AMOLED). -->
    <color name="log_level_error">#FFE53935</color>
    <color name="log_level_warn">#FFFB8C00</color>
    <color name="log_level_info">#FF43A047</color>
    <color name="log_level_debug">#FF1E88E5</color>
    <color name="log_level_verbose">#FF9E9E9E</color>
</resources>
