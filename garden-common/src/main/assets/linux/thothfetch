#!/bin/bash
# Lightweight ThothTerm-native welcome; no external commands required.
#
# Geometry contract (regression-tested by ThothfetchTest):
#  - The mark is a fixed 10-column ASCII block, mirror-symmetric about column 4.5.
#  - Wide lines place their info text at printable column 14 (0-based).
#  - ANSI color sequences wrap whole fields and never contribute a column.
#  - No tabs; alignment never depends on trailing whitespace.
#  - The layout is chosen from the real PTY width, not bash's unexported COLUMNS.
#
# The product name comes from /etc/thothterm/edition, which the app writes, and
# the system name from PRETTY_NAME in /etc/os-release, so an upgrade to a new
# point release shows up here without an app update. Both files are read as
# data, never sourced, and stripped of control characters before printing.
#
# Colours are the edition's: /etc/thothterm/palette, which the app writes,
# maps roles to SGR parameters. Nothing here names a colour. Without that file,
# or with NO_COLOR set, the banner is plain text.

root=${THOTHTERM_GUEST_ROOT-}

primary= secondary= highlight= foreground= muted= reset=
if [ -z "${NO_COLOR-}" ] && [ -r "$root/etc/thothterm/palette" ]; then
  while IFS='=' read -r role sgr; do
    case $sgr in ''|*[!0-9\;]*) continue ;; esac
    case $role in
      primary) primary=$'\033['"${sgr}m" ;;
      secondary) secondary=$'\033['"${sgr}m" ;;
      highlight) highlight=$'\033['"${sgr}m" ;;
      foreground) foreground=$'\033['"${sgr}m" ;;
      muted) muted=$'\033['"${sgr}m" ;;
      *) continue ;;
    esac
    reset=$'\033[0m'
  done < "$root/etc/thothterm/palette"
fi

# Printable text only, at most $2 characters.
clean() {
  local text=${1//[[:cntrl:]]/}
  printf '%s' "${text:0:$2}"
}

edition=
if [ -r "$root/etc/thothterm/edition" ]; then
  IFS= read -r edition < "$root/etc/thothterm/edition"
fi
[ -n "$edition" ] || edition=ThothTerm

os=
if [ -r "$root/etc/os-release" ]; then
  while IFS= read -r line; do
    case $line in
      PRETTY_NAME=*)
        os=${line#PRETTY_NAME=}
        case $os in
          \"*\") os=${os#\"}; os=${os%\"} ;;
          \'*\') os=${os#\'}; os=${os%\'} ;;
        esac
        os=${os//\\\"/\"}; os=${os//\\\\/\\}
        break ;;
    esac
  done < "$root/etc/os-release"
fi
[ -n "$os" ] || os=Linux

cols=
size=$(stty size 2>/dev/null)
cols=${size##* }
case "${cols:-}" in
  ''|*[!0-9]*) cols=${COLUMNS:-80} ;;
esac
case "${cols:-}" in
  ''|*[!0-9]*) cols=80 ;;
esac

arch=${HOSTTYPE:-aarch64}

# ThothDock QA builds bind the Docker CLI at /usr/local/bin/docker; only then
# does the banner describe the engine. Nothing is run here: the socket exists
# only while the daemon serves it, so its presence is the live state.
dock=
if [ -e "$root/usr/local/bin/docker" ]; then
  dock=1
  engine=Offline
  [ -S "$root/run/thothdock/thothdock.sock" ] && engine=ThothDock
fi

# The ThothDock mark: the icon's Thoth-bird T over two container stacks and a
# tray. Every row is padded to 20 columns (ThothfetchTest checks it); info
# text starts at column 21 and the longest line is 62 columns, so it fits a
# 63-column phone terminal without wrapping.
# Colours by role: primary (bird, tray), secondary (containers), muted (T bar).
dock_mark() {
  local p=$primary s=$secondary t=$muted r=$reset
  mark[0]="${t}  ______ ${p}.-'-.${t} _____${r}"
  mark[1]="${t}  \\____ \\${p}/ (o)\\${t}/___/${r}"
  mark[2]="${t}        ||${p} \`-.__\`.  ${r}"
  mark[3]="${s} .---.${t}  ||${p}     \`-'  ${r}"
  mark[4]="${s} |:::|${t}  ||  ${s}.---.   ${r}"
  mark[5]="${s} |:::|${t}  ||  ${s}|:::|   ${r}"
  mark[6]="${p} /${s}:::${p}\\__${t}||${p}__/${s}:::${p}\\   ${r}"
  mark[7]="${p} \\_____ \\/ _____/   ${r}"
  mark[8]="${p}   \\____\\/____/     ${r}"
}

if [ -n "$dock" ] && [ "$cols" -ge 62 ]; then
  edition=$(clean "$edition" 30)
  os=$(clean "$os" 28)
  m=$muted
  dock_mark
  pad=' '
  printf '%s\n' "${mark[0]}${pad}${highlight}${edition}${reset}"
  printf '%s\n' "${mark[1]}${pad}${foreground}ThothTerm Container Runtime${reset}"
  printf '%s\n' "${mark[2]}"
  printf '%s\n' "${mark[3]}${pad}${m}Guest        ${reset}${foreground}${os}${reset}"
  printf '%s\n' "${mark[4]}${pad}${m}Architecture ${reset}${foreground}$(clean "$arch" 16)${reset}"
  printf '%s\n' "${mark[5]}${pad}${m}Shell        ${reset}${foreground}Bash${reset}"
  printf '%s\n' "${mark[6]}${pad}${m}Engine       ${reset}${foreground}${engine}${reset}"
  printf '%s\n' "${mark[7]}${pad}${m}Docker API   ${reset}${foreground}1.41${reset}"
  printf '%s\n' "${mark[8]}${pad}${m}Runtime      ${reset}${foreground}Garden PRoot${reset}"
elif [ -n "$dock" ] && [ "$cols" -ge 20 ] && [ "$cols" -lt 62 ]; then
  # Narrow screens keep the ThothDock mark above the text.
  edition=$(clean "$edition" "$cols")
  os=$(clean "$os" "$cols")
  dock_mark
  for i in 0 1 2 3 4 5 6 7 8; do printf '%s\n' "${mark[$i]}"; done
  printf '\n'
  printf '%s\n' "${highlight}${edition}${reset}"
  printf '%s\n' "${foreground}${os}${reset}"
  printf '%s\n' "${muted}Engine ${reset}${foreground}${engine}${reset}"
elif [ "$cols" -lt 44 ]; then
  edition=$(clean "$edition" "$cols")
  os=$(clean "$os" "$cols")
  printf '%s\n' "${primary}    /\\${reset}"
  printf '%s\n' "${primary} __/  \\__${reset}"
  printf '%s\n' "${secondary}/  \\  /  \\${reset}"
  printf '%s\n' "${secondary}\\   \\/   /${reset}"
  printf '%s\n' "${primary} \\  /\\  /${reset}"
  printf '%s\n' "${primary}    \\/${reset}"
  printf '%s\n' "${secondary}    >_${reset}"
  printf '\n'
  printf '%s\n' "${highlight}${edition}${reset}"
  printf '%s\n' "${foreground}${os}${reset}"
  printf '%s\n' "${muted}User  ${reset}${foreground}thoth${reset}"
  printf '%s\n' "${muted}Home  ${reset}${foreground}/home/thoth${reset}"
  if [ -n "$dock" ]; then
    printf '%s\n' "${muted}Engine ${reset}${foreground}${engine}${reset}"
  fi
else
  edition=$(clean "$edition" 30)
  os=$(clean "$os" 30)
  printf '%s\n' "${primary}    /\\${reset}        ${highlight}${edition}${reset}"
  printf '%s\n' "${primary} __/  \\__${reset}     ${foreground}${os}${reset}"
  printf '%s\n' "${secondary}/  \\  /  \\${reset}    ${muted}Architecture  ${reset}${foreground}$(clean "$arch" 16)${reset}"
  printf '%s\n' "${secondary}\\   \\/   /${reset}    ${muted}Shell         ${reset}${foreground}Bash${reset}"
  printf '%s\n' "${primary} \\  /\\  /${reset}     ${muted}Home          ${reset}${foreground}/home/thoth${reset}"
  printf '%s\n' "${primary}    \\/${reset}        ${muted}User          ${reset}${foreground}thoth${reset}"
  printf '%s\n' "${secondary}    >_${reset}"
fi
