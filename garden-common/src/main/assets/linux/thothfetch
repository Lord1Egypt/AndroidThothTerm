#!/bin/bash
# Lightweight ThothTerm-native welcome; no external commands required.
#
# Geometry contract (regression-tested by ThothfetchTest):
#  - The mark is a fixed 10-column ASCII block, mirror-symmetric about column 4.5.
#  - Wide lines place their info text at printable column 14 (0-based).
#  - ANSI color sequences wrap whole fields and never contribute a column.
#  - No tabs; alignment never depends on trailing whitespace.
#  - The layout is chosen from the real PTY width, not bash's unexported COLUMNS.
#
# The product name comes from /etc/thothterm/edition, which the app writes, and
# the system name from PRETTY_NAME in /etc/os-release, so an upgrade to a new
# point release shows up here without an app update. Both files are read as
# data, never sourced, and stripped of control characters before printing.
amber=$'\033[38;5;214m'; teal=$'\033[38;5;44m'
white=$'\033[38;5;252m'; muted=$'\033[38;5;246m'; reset=$'\033[0m'

root=${THOTHFETCH_ROOT-}

# Printable text only, at most $2 characters.
clean() {
  local text=${1//[[:cntrl:]]/}
  printf '%s' "${text:0:$2}"
}

edition=
if [ -r "$root/etc/thothterm/edition" ]; then
  IFS= read -r edition < "$root/etc/thothterm/edition"
fi
[ -n "$edition" ] || edition=ThothTerm

os=
if [ -r "$root/etc/os-release" ]; then
  while IFS= read -r line; do
    case $line in
      PRETTY_NAME=*)
        os=${line#PRETTY_NAME=}
        case $os in
          \"*\") os=${os#\"}; os=${os%\"} ;;
          \'*\') os=${os#\'}; os=${os%\'} ;;
        esac
        os=${os//\\\"/\"}; os=${os//\\\\/\\}
        break ;;
    esac
  done < "$root/etc/os-release"
fi
[ -n "$os" ] || os=Linux

cols=
size=$(stty size 2>/dev/null)
cols=${size##* }
case "${cols:-}" in
  ''|*[!0-9]*) cols=${COLUMNS:-80} ;;
esac
case "${cols:-}" in
  ''|*[!0-9]*) cols=80 ;;
esac

arch=${HOSTTYPE:-aarch64}

if [ "$cols" -lt 44 ]; then
  edition=$(clean "$edition" "$cols")
  os=$(clean "$os" "$cols")
  printf '%s\n' "${amber}    /\\${reset}"
  printf '%s\n' "${amber} __/  \\__${reset}"
  printf '%s\n' "${teal}/  \\  /  \\${reset}"
  printf '%s\n' "${teal}\\   \\/   /${reset}"
  printf '%s\n' "${amber} \\  /\\  /${reset}"
  printf '%s\n' "${amber}    \\/${reset}"
  printf '%s\n' "${teal}    >_${reset}"
  printf '\n'
  printf '%s\n' "${white}${edition}${reset}"
  printf '%s\n' "${muted}${os}${reset}"
  printf '%s\n' "${muted}User  thoth${reset}"
  printf '%s\n' "${muted}Home  /home/thoth${reset}"
else
  edition=$(clean "$edition" 30)
  os=$(clean "$os" 30)
  printf '%s\n' "${amber}    /\\${reset}        ${white}${edition}${reset}"
  printf '%s\n' "${amber} __/  \\__${reset}     ${muted}${os}${reset}"
  printf '%s\n' "${teal}/  \\  /  \\${reset}    ${muted}Architecture  $(clean "$arch" 16)${reset}"
  printf '%s\n' "${teal}\\   \\/   /${reset}    ${muted}Shell         Bash${reset}"
  printf '%s\n' "${amber} \\  /\\  /${reset}     ${muted}Home          /home/thoth${reset}"
  printf '%s\n' "${amber}    \\/${reset}        ${muted}User          thoth${reset}"
  printf '%s\n' "${teal}    >_${reset}"
fi
