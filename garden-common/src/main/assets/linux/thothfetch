render_logo() {
  local line cell out code last i
  while IFS= read -r line; do
    if [ -z "$reset" ]; then printf '%s\n' "$line"; continue; fi
    out= last=
    for ((i = 0; i < ${#line}; i++)); do
      case ${line:i:1} in
        '@') code=233 ;; '%') code=236 ;; '#') code=240 ;; '*') code=25 ;; '+') code=26 ;;
        '=') code=32 ;; '-') code=38 ;; ':') code=44 ;; '.') code=51 ;; *) code=123 ;;
      esac
      [ "$code" = "$last" ] || out+=$'\033[48;5;'"${code}m"
      out+=' ' last=$code
    done
    printf '%s\n' "${out}${reset}"
  done < <(logo_art)
}

# ThothDock QA builds bind the Docker CLI at /usr/local/bin/docker; only then
# does the banner describe the engine. Nothing is run here: the socket exists
# only while the daemon serves it, so its presence is the live state.
dock=
if [ -e "$root/usr/local/bin/docker" ]; then
  dock=1
  engine=Offline
  [ -S "$root/run/thothdock/thothdock.sock" ] && engine=ThothDock
fi

if [ -n "$dock" ] && [ -z "$logo" ] && [ "$cols" -ge 100 ] && [ "$rows" -ge 64 ]; then
  logo=1
fi
if [ -n "$logo" ]; then
  edition=$(clean "$edition" 30)
  os=$(clean "$os" 40)
  m=$muted
  render_logo
  printf '\n%s\n' "${highlight}${edition}${reset}  ${foreground}ThothTerm Container Runtime${reset}"
  printf '%s\n' "${m}Guest         ${reset}${foreground}${os}${reset}"
  printf '%s\n' "${m}Architecture  ${reset}${foreground}$(clean "$arch" 16)${reset}"
  [ -n "$dock" ] && printf '%s\n' "${m}Engine        ${reset}${foreground}${engine}${reset}"
  exit 0
fi

