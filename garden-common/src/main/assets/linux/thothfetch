# show_logo ART WIDTH LAYOUT START LABEL_WIDTH: print a logo banner with the info.
show_logo() {
  local -n art=$1
  local w=$2 layout=$3 start=$4 lw=$5 i n=${#art[@]} m=$muted j
  local label_arch='Architecture' label_api='Docker API'
  if [ "$lw" -lt 12 ]; then label_arch=Arch; label_api=API; fi
  local info=(
    "${highlight}${edition}${reset}"
    "${foreground}ThothTerm Container Runtime${reset}"
    ""
    "${m}$(printf '%-*s' "$lw" Guest)${reset}${foreground}${os}${reset}"
    "${m}$(printf '%-*s' "$lw" "$label_arch")${reset}${foreground}$(clean "$arch" 16)${reset}"
    "${m}$(printf '%-*s' "$lw" Shell)${reset}${foreground}Bash${reset}"
    "${m}$(printf '%-*s' "$lw" Engine)${reset}${foreground}${engine}${reset}"
    "${m}$(printf '%-*s' "$lw" "$label_api")${reset}${foreground}1.41${reset}"
    "${m}$(printf '%-*s' "$lw" Runtime)${reset}${foreground}Garden PRoot${reset}"
  )
  if [ "$layout" = stacked ]; then
    for ((i = 0; i < n; i++)); do printf '%s\n' "${art[i]}"; done
    printf '\n%s\n%s\n%s\n' "${info[0]}" "${foreground}${os}${reset}" "${m}Engine ${reset}${foreground}${engine}${reset}"
    return
  fi
  local total=$n
  [ $((start + ${#info[@]})) -gt "$total" ] && total=$((start + ${#info[@]}))
  for ((i = 0; i < total; i++)); do
    if [ "$i" -lt "$n" ]; then printf '%s' "${art[i]}"; else printf '%*s' "$w" ''; fi
    j=$((i - start))
    if [ "$j" -ge 0 ] && [ "$j" -lt ${#info[@]} ] && [ -n "${info[j]}" ]; then printf '  %s' "${info[j]}"; fi
    printf '\n'
  done
}

# paint ROW: colours one art row by character role; spaces stay uncoloured.
paint() {
  local row=$1 out= c col i
  if [ -z "$reset" ]; then printf '%s' "$row"; return; fi
  for ((i = 0; i < ${#row}; i++)); do
    c=${row:i:1}
    case $c in
      ' ') out+=' '; continue ;;
      '['|']') col=$secondary ;;
      '^'|'o'|'>'|'('|')'|'V'|'.'|'-'|'D'|'c'|'k') col=$primary ;;
      [A-Z]) col=$foreground ;;
      *) col=$muted ;;
    esac
    out+="$col$c"
  done
  printf '%s' "${out}${reset}"
}

# show_banner ART_NAME WIDTH LAYOUT: layout side (info beside the art) or stacked.
show_banner() {
  local -n art=$1
  local w=$2 layout=$3 i n=${#art[@]} row info
  local m=$muted
  info=(
    "${highlight}${edition}${reset}"
    "${foreground}ThothTerm Container Runtime${reset}"
    ""
    "${m}Guest         ${reset}${foreground}${os}${reset}"
    "${m}Architecture  ${reset}${foreground}$(clean "$arch" 16)${reset}"
    "${m}Shell         ${reset}${foreground}Bash${reset}"
    "${m}Engine        ${reset}${foreground}${engine}${reset}"
    "${m}Docker API    ${reset}${foreground}1.41${reset}"
    "${m}Runtime       ${reset}${foreground}Garden PRoot${reset}"
  )
  if [ "$layout" = stacked ]; then
    for ((i = 0; i < n; i++)); do paint "${art[i]}"; printf '\n'; done
    printf '\n'
    printf '%s\n' "${info[0]}"
    printf '%s\n' "${foreground}${os}${reset}"
    printf '%s\n' "${m}Engine ${reset}${foreground}${engine}${reset}"
    return
  fi
  local total=$n
  [ ${#info[@]} -gt "$total" ] && total=${#info[@]}
  for ((i = 0; i < total; i++)); do
    if [ "$i" -lt "$n" ]; then
      row=$(printf '%-*s' "$w" "${art[i]}")
    else
      row=$(printf '%*s' "$w" '')
    fi
    paint "$row"
    if [ -n "${info[i]-}" ]; then printf '  %s' "${info[i]}"; fi
    printf '\n'
  done
}

if [ -n "$dock" ] && [ "$cols" -ge 20 ]; then
  limit=30
  [ "$cols" -lt 30 ] && limit=$cols
  edition=$(clean "$edition" "$limit")
  os=$(clean "$os" "$((limit > 28 ? 28 : limit))")
  if [ -n "$reset" ] && [ "$cols" -ge 32 ]; then
    # Colours available: the logo-derived braille banners.
    if [ "$cols" -ge 110 ]; then show_logo logo_l "$logo_l_w" side 10 14
    elif [ "$cols" -ge 62 ]; then show_logo logo_s "$logo_s_w" side 1 8
    else show_logo logo_m "$logo_m_w" stacked 0 13
    fi
  elif [ "$cols" -ge 80 ]; then show_banner wide_art "$wide_w" side
  elif [ "$cols" -ge 62 ]; then show_banner compact_art "$compact_w" side
  else show_banner compact_art "$compact_w" stacked
  fi
elif [ "$cols" -lt 44 ]; then
  edition=$(clean "$edition" "$cols")
  os=$(clean "$os" "$cols")
  printf '%s\n' "${primary}    /\\${reset}"
  printf '%s\n' "${primary} __/  \\__${reset}"
  printf '%s\n' "${secondary}/  \\  /  \\${reset}"
  printf '%s\n' "${secondary}\\   \\/   /${reset}"
  printf '%s\n' "${primary} \\  /\\  /${reset}"
  printf '%s\n' "${primary}    \\/${reset}"
  printf '%s\n' "${secondary}    >_${reset}"
  printf '\n'
  printf '%s\n' "${highlight}${edition}${reset}"
  printf '%s\n' "${foreground}${os}${reset}"
  printf '%s\n' "${muted}User  ${reset}${foreground}thoth${reset}"
  printf '%s\n' "${muted}Home  ${reset}${foreground}/home/thoth${reset}"
  if [ -n "$dock" ]; then
    printf '%s\n' "${muted}Engine ${reset}${foreground}${engine}${reset}"
  fi
else
  edition=$(clean "$edition" 30)
  os=$(clean "$os" 30)
  printf '%s\n' "${primary}    /\\${reset}        ${highlight}${edition}${reset}"
  printf '%s\n' "${primary} __/  \\__${reset}     ${foreground}${os}${reset}"
  printf '%s\n' "${secondary}/  \\  /  \\${reset}    ${muted}Architecture  ${reset}${foreground}$(clean "$arch" 16)${reset}"
  printf '%s\n' "${secondary}\\   \\/   /${reset}    ${muted}Shell         ${reset}${foreground}Bash${reset}"
  printf '%s\n' "${primary} \\  /\\  /${reset}     ${muted}Home          ${reset}${foreground}/home/thoth${reset}"
  printf '%s\n' "${primary}    \\/${reset}        ${muted}User          ${reset}${foreground}thoth${reset}"
  printf '%s\n' "${secondary}    >_${reset}"
fi
