#!/bin/sh
# Managed by ThothTerm (rewritten on every window; do not edit).
# Runs Debian's own flatpak with what a PRoot guest lacks:
# * Its sandboxes go to ThothDock through $FLATPAK_BWRAP. sudo clears the
#   environment, so it is set here as well: "sudo flatpak" would otherwise
#   fall back to the stock bwrap, which needs user namespaces Android denies.
# * Debian's flatpak asks the system D-Bus about parental controls before it
#   installs an app, and a PRoot guest runs no system bus by itself ("Could
#   not connect: No such file or directory"). Start one when none answers.
# * On first use it installs flatpak and dbus (only Recommended by flatpak,
#   but needed for that bus) and adds the Flathub remote.
BWRAP=/usr/libexec/thothdock/bwrap
if [ -z "${FLATPAK_BWRAP-}" ] && [ -x "$BWRAP" ]; then
    FLATPAK_BWRAP="$BWRAP"
    export FLATPAK_BWRAP
fi
if [ ! -x /usr/bin/flatpak ] || ! command -v dbus-daemon >/dev/null 2>&1; then
    echo "Installing flatpak (first use)..." >&2
    if ! sudo sh -c 'export DEBIAN_FRONTEND=noninteractive
        apt-get install -y --no-install-recommends flatpak dbus ||
        { apt-get update && apt-get install -y --no-install-recommends flatpak dbus; }' >&2; then
        echo "flatpak could not be installed. Try: sudo apt install flatpak dbus" >&2
        exit 127
    fi
    flatpak_first_use=1
fi
if ! dbus-send --system --dest=org.freedesktop.DBus --type=method_call --print-reply \
        /org/freedesktop/DBus org.freedesktop.DBus.GetId >/dev/null 2>&1; then
    # A socket and pid file left by a bus that ended with the last window.
    sudo -n sh -c 'mkdir -p /run/dbus && rm -f /run/dbus/pid /run/dbus/system_bus_socket && dbus-daemon --system --fork' \
        >/dev/null 2>&1 || echo "flatpak (ThothTerm): could not start the system D-Bus; app installs may fail" >&2
fi
if [ -n "${flatpak_first_use-}" ]; then
    /usr/bin/flatpak remote-add --user --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo >&2 &&
        echo "Flathub added: flatpak install flathub <app>" >&2 ||
        echo "Flathub was not added: flatpak remote-add --user flathub https://dl.flathub.org/repo/flathub.flatpakrepo" >&2
fi
exec /usr/bin/flatpak "$@"
