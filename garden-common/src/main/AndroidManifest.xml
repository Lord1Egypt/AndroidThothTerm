<?xml version="1.0" encoding="utf-8"?>
<!--
  Garden components, merged into every ThothTerm distribution edition.

  Only the launcher entry (the first-run/setup activity) is exported. The
  Regular Terminal's integration surfaces (RemoteInterface, RunScript and its
  permission, RunShortcut, AddShortcut, FileSelection, the ICommand protocol and
  the exported ITerminal binder) are deliberately absent; see
  docs/garden/ARCHITECTURE.md.
-->
<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false"/>

    <!-- Guest networking (apt, curl, DNS) and LAN mode's listener. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- LAN mode: find the Wi-Fi/Ethernet address; refresh the guest resolver. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"/>

    <application
        android:name=".Application"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:hardwareAccelerated="true"
        android:resizeableActivity="true"
        android:theme="@style/AppTheme.NoActionBar"
        tools:ignore="GoogleAppIndexingWarning">
        <activity
            android:name="com.thothterm.garden.GardenSetupActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|layoutDirection|navigation|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>

                <category android:name="android.intent.category.LAUNCHER"/>
                <category android:name="android.intent.category.MULTIWINDOW_LAUNCHER"/>
            </intent-filter>
        </activity>
        <activity
            android:name=".TermActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|layoutDirection|navigation|uiMode|density"
            android:exported="false"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize|stateAlwaysVisible"/>
        <service
            android:name="jackpal.androidterm.TermService"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="@string/service_special_use"/>
        </service>
        <activity
            android:name=".WindowListActivity"
            android:exported="false"
            android:label="@string/window_list"
            android:parentActivityName="com.thothterm.TermActivity">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value="com.thothterm.TermActivity"/>
        </activity>
        <activity
            android:name=".TermPreferencesActivity"
            android:exported="false"
            android:label="@string/preferences"
            android:parentActivityName="com.thothterm.TermActivity"
            android:theme="@style/AppTheme">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value="com.thothterm.TermActivity"/>
        </activity>
        <activity
            android:name=".LogsActivity"
            android:exported="false"
            android:label="@string/diagnostics_logs"
            android:parentActivityName="com.thothterm.TermActivity">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value="com.thothterm.TermActivity"/>
        </activity>

        <meta-data
            android:name="com.sec.android.support.multiwindow"
            android:value="true"/>
        <meta-data
            android:name="android.max_aspect"
            android:value="2.4"/>
        <meta-data
            android:name="com.samsung.android.multidisplay.keep_process_alive"
            android:value="true"/>
        <meta-data
            android:name="com.samsung.android.keepalive.density"
            android:value="true"/>
    </application>

    <!-- Android 11+: open http(s) links shown in the terminal. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="http"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
    </queries>
</manifest>
