diff --git a/src/extension/hostname/hostname.c b/src/extension/hostname/hostname.c
new file mode 100644
index 0000000..f1460b3
--- /dev/null
+++ b/src/extension/hostname/hostname.c
@@ -0,0 +1,72 @@
+/* -*- c-set-style: "K&R"; c-basic-offset: 8 -*-
+ *
+ * --hostname=NAME: uname(2) reports NAME as the node name, so a guest sees
+ * the host name its container was given (Docker gives each container its
+ * own UTS namespace).  Only uname is intercepted, at its exit; the other
+ * fields, sethostname and everything else are left to the kernel.
+ */
+
+#include <stddef.h>      /* offsetof, */
+#include <string.h>      /* strlen, strcpy, */
+#include <sys/utsname.h> /* struct utsname, */
+
+#include "extension/extension.h"
+#include "tracee/tracee.h"
+#include "tracee/reg.h"
+#include "tracee/mem.h"
+#include "syscall/sysnum.h"
+
+typedef struct {
+	char nodename[sizeof(((struct utsname *) 0)->nodename)];
+} Config;
+
+/* A node name fits struct utsname and has no NUL or '/'.  */
+int hostname_valid(const char *value)
+{
+	size_t length = strlen(value);
+	return length > 0 && length < sizeof(((Config *) 0)->nodename) && strchr(value, '/') == NULL;
+}
+
+int hostname_callback(Extension *extension, ExtensionEvent event, intptr_t data1, intptr_t data2 UNUSED)
+{
+	switch (event) {
+	case INITIALIZATION: {
+		static FilteredSysnum filtered_sysnums[] = {
+			{ PR_uname,	FILTER_SYSEXIT },
+			FILTERED_SYSNUM_END,
+		};
+		Config *config;
+
+		if (!hostname_valid((const char *) data1))
+			return -1;
+		config = talloc_zero(extension, Config);
+		if (config == NULL)
+			return -1;
+		strcpy(config->nodename, (const char *) data1);
+		extension->config = config;
+		extension->filtered_sysnums = filtered_sysnums;
+		return 0;
+	}
+
+	case INHERIT_PARENT:
+		/* The configuration never changes: share it.  */
+		return 0;
+
+	case SYSCALL_EXIT_END: {
+		Tracee *tracee = TRACEE(extension);
+		const Config *config = talloc_get_type_abort(extension->config, Config);
+		word_t address;
+
+		if (get_sysnum(tracee, ORIGINAL) != PR_uname
+		    || (int) peek_reg(tracee, CURRENT, SYSARG_RESULT) < 0)
+			return 0;
+
+		address = peek_reg(tracee, ORIGINAL, SYSARG_1);
+		return write_data(tracee, address + offsetof(struct utsname, nodename),
+				config->nodename, sizeof(config->nodename));
+	}
+
+	default:
+		return 0;
+	}
+}
