+static int handle_option_net_ip(Tracee *tracee, const Cli *cli UNUSED, const char *value)
+{
+	uint32_t own;
+
+	if (net_ip_parse(value, &own) < 0) {
+		note(tracee, ERROR, USER, "--net-ip=%s: not a container address in 127.77.0.0/16 "
+			"(the network, 127.77.0.1 and the broadcast address are reserved)", value);
+		return -1;
+	}
+
+	if (initialize_extension(tracee, net_ip_callback, value) < 0) {
+		note(tracee, ERROR, INTERNAL, "net_ip not initialized");
+		return -1;
+	}
+
+	return 0;
+}
