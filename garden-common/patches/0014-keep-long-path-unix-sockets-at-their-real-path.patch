+		    || strlen(shorter_host_path) > sizeof_path)
 			return -EINVAL;
 
 		/* Ensure the guest path of this new binding is
@@ -144,6 +318,7 @@ int translate_socketcall_enter(Tracee *tracee, word_t *address, int size)
 		/* Let's use this shorter path now.  */
 		strcpy(host_path, shorter_host_path);
 	}
+shortened:
 	strncpy(sockaddr.sun_path, host_path, sizeof_path);
 
 	/* Push the updated sockaddr to a newly allocated space.  */
@@ -185,6 +360,21 @@ int translate_socketcall_exit(Tracee *tracee, word_t sock_addr, word_t size_addr
 	if (status <= 0)
 		return status;
 
+	/* A socket moved to its real path by long_socket_path().  */
+	{
+		const char *dir = get_temp_directory();
+		size_t dir_length = strlen(dir);
+		if (strncmp(path, dir, dir_length) == 0
+		    && strncmp(path + dir_length, "/" SOCKET_ALIAS_PREFIX, strlen(SOCKET_ALIAS_PREFIX) + 1) == 0) {
+			char target[PATH_MAX];
+			ssize_t length = readlink(path, target, sizeof(target) - 1);
+			if (length > 0) {
+				target[length] = '\0';
+				strcpy(path, target);
+			}
+		}
+	}
+
 	status = detranslate_path(tracee, path, NULL);
 	if (status < 0)
 		return status;
