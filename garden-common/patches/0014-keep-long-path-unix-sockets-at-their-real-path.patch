+/*
+ * A Unix socket whose host path does not fit sun_path (a container's
+ * rootfs is deep) must still live at that path and be reachable from every
+ * PRoot: "docker exec psql" or a second container sharing the volume runs
+ * in another PRoot, which a per-PRoot binding to a random short name never
+ * reaches.  Each such path gets a deterministic short name in PRoot's
+ * temporary directory, prootsock-<hash of the host path>:
+ *
+ * - bind: like the kernel, refuse an address that exists (EADDRINUSE);
+ *   bind at the short name, and at the syscall's exit rename the socket to
+ *   its real path and leave the short name as a symlink to it;
+ * - connect: through the short name, (re)created as a symlink to the real
+ *   path by whichever PRoot needs it;
+ * - getsockname, getpeername, accept: the kernel reports the short name;
+ *   it is read back through the symlink to the real path.
+ *
+ * Symlinks whose socket is gone are removed at the next such bind.
+ */
+#define SOCKET_ALIAS_PREFIX "prootsock-"
+
+static void socket_alias_name(char alias[PATH_MAX], const char *host_path)
+{
+	uint64_t hash = 0xcbf29ce484222325ULL; /* FNV-1a */
+	const char *c;
+
+	for (c = host_path; *c != '\0'; c++)
+		hash = (hash ^ (unsigned char) *c) * 0x100000001b3ULL;
+	snprintf(alias, PATH_MAX, "%s/" SOCKET_ALIAS_PREFIX "%016llx",
+		get_temp_directory(), (unsigned long long) hash);
+}
+
+static void sweep_socket_aliases(void)
+{
+	char path[PATH_MAX];
+	struct dirent *entry;
+	struct stat st;
+	DIR *dir;
+
+	dir = opendir(get_temp_directory());
+	if (dir == NULL)
+		return;
+	while ((entry = readdir(dir)) != NULL) {
+		if (strncmp(entry->d_name, SOCKET_ALIAS_PREFIX, strlen(SOCKET_ALIAS_PREFIX)) != 0)
+			continue;
+		snprintf(path, sizeof(path), "%s/%s", get_temp_directory(), entry->d_name);
+		/* A symlink whose target is gone.  */
+		if (lstat(path, &st) == 0 && S_ISLNK(st.st_mode) && stat(path, &st) < 0)
+			(void) unlink(path);
+	}
+	closedir(dir);
+}
+
+/* Point @alias at @host_path, unless it already does.  */
+static int link_socket_alias(const char *alias, const char *host_path)
+{
+	char target[PATH_MAX];
+	ssize_t length;
+
+	length = readlink(alias, target, sizeof(target) - 1);
+	if (length >= 0) {
+		target[length] = '\0';
+		if (strcmp(target, host_path) == 0)
+			return 0;
+	}
+	(void) unlink(alias);
+	if (symlink(host_path, alias) < 0 && errno != EEXIST)
+		return -errno;
+	return 0;
+}
+
+/**
+ * Handle a bind or connect to @host_path, too long for sun_path: put the
+ * short name to use in @host_path.  Returns 1 when handled, 0 to fall back
+ * to a per-PRoot binding, or -errno.
+ */
+static int long_socket_path(Tracee *tracee, char host_path[PATH_MAX], const char *user_path)
+{
+	word_t sysnum = get_sysnum(tracee, ORIGINAL);
+	char alias[PATH_MAX];
+	struct stat st;
+
+	if (sysnum != PR_bind && sysnum != PR_connect)
+		return 0;
+
+	socket_alias_name(alias, host_path);
+	if (strlen(alias) >= sizeof_path)
+		return 0;
+
+	if (sysnum == PR_connect) {
+		if (link_socket_alias(alias, host_path) < 0)
+			return 0;
+		strcpy(host_path, alias);
+		return 1;
+	}
+
+	if (lstat(host_path, &st) == 0)
+		return -EADDRINUSE;
+	sweep_socket_aliases();
+	/* The name of a previous socket at this path.  */
+	(void) unlink(alias);
+
+	TALLOC_FREE(tracee->socket_short);
+	TALLOC_FREE(tracee->socket_long);
+	TALLOC_FREE(tracee->socket_guest);
+	tracee->socket_short = talloc_strdup(tracee, alias);
+	tracee->socket_long  = talloc_strdup(tracee, host_path);
+	{
+		/* The canonical guest path, for the fallback binding.  */
+		char guest[PATH_MAX];
+		strcpy(guest, host_path);
+		tracee->socket_guest = talloc_strdup(tracee,
+			detranslate_path(tracee, guest, NULL) < 0 ? user_path : guest);
+	}
+
+	/* Stop at the exit of this syscall too.  */
+	tracee->restart_how = PTRACE_SYSCALL;
+
+	strcpy(host_path, alias);
+	return 1;
+}
+
+/**
+ * At the exit of a bind handled by long_socket_path() (@result is its
+ * result): move the socket to its real path and leave the short name as a
+ * symlink to it.  If the rename fails, the socket stays at the short name
+ * and a binding keeps it reachable from this PRoot, as before.
+ */
+void finish_long_socket_path(Tracee *tracee, int result)
+{
+	if (tracee->socket_short == NULL)
+		return;
+
+	if (result == 0) {
+		if (rename(tracee->socket_short, tracee->socket_long) == 0)
+			(void) link_socket_alias(tracee->socket_short, tracee->socket_long);
+		else {
+			Binding *binding = insort_binding3(tracee, tracee->ctx,
+					tracee->socket_short, tracee->socket_guest);
+			if (binding != NULL)
+				(void) talloc_reference(binding, tracee->socket_short);
+		}
+	}
+
+	TALLOC_FREE(tracee->socket_short);
+	TALLOC_FREE(tracee->socket_long);
+	TALLOC_FREE(tracee->socket_guest);
+}
+
 /**
  * Translate the pathname of the struct sockaddr_un currently stored
  * in the @tracee memory at the given @address.  See the documentation
@@ -114,6 +269,12 @@ int translate_socketcall_enter(Tracee *tracee, word_t *address, int size)
 		char *shorter_host_path;
 		Binding *binding;
 
+		status = long_socket_path(tracee, host_path, user_path);
+		if (status < 0)
+			return status;
+		if (status > 0)
+			goto shortened;
+
 		/* The translated path is too long to fit the sun_path
 		 * array, so let's bind it to a shorter path.  */
 		shorter_host_path = create_temp_name(tracee->ctx, "proot");
@@ -144,6 +305,7 @@ int translate_socketcall_enter(Tracee *tracee, word_t *address, int size)
 		/* Let's use this shorter path now.  */
 		strcpy(host_path, shorter_host_path);
 	}
+shortened:
 	strncpy(sockaddr.sun_path, host_path, sizeof_path);
 
 	/* Push the updated sockaddr to a newly allocated space.  */
@@ -185,6 +347,21 @@ int translate_socketcall_exit(Tracee *tracee, word_t sock_addr, word_t size_addr
 	if (status <= 0)
 		return status;
 
+	/* A socket moved to its real path by long_socket_path().  */
+	{
+		const char *dir = get_temp_directory();
+		size_t dir_length = strlen(dir);
+		if (strncmp(path, dir, dir_length) == 0
+		    && strncmp(path + dir_length, "/" SOCKET_ALIAS_PREFIX, strlen(SOCKET_ALIAS_PREFIX) + 1) == 0) {
+			char target[PATH_MAX];
+			ssize_t length = readlink(path, target, sizeof(target) - 1);
+			if (length > 0) {
+				target[length] = '\0';
+				strcpy(path, target);
+			}
+		}
+	}
+
 	status = detranslate_path(tracee, path, NULL);
 	if (status < 0)
 		return status;
