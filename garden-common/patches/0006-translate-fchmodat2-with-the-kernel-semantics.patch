diff -ruN a/src/syscall/enter.c b/src/syscall/enter.c
--- a/src/syscall/enter.c
+++ b/src/syscall/enter.c
@@ -45,6 +45,7 @@
 #include <netpacket/packet.h> /* struct sockaddr_ll (AF_PACKET) */
 #include <sys/ioctl.h>   /* ioctl(2): SIOCGIFMTU / SIOCGIFHWADDR */
 #include <sys/time.h>    /* struct timeval, for SO_RCVTIMEO */
+#include <sys/stat.h>    /* lstat(2), for fchmodat2 */
 #include "syscall/pipe_shadow.h"
 
 /* ABI-stable rtnetlink constants we synthesise for the loopback reply.
@@ -2528,6 +2529,80 @@
 		status = translate_path2(tracee, dirfd, path, SYSARG_2, REGULAR);
 		break;
 
+	case PR_fchmodat2: {
+		/* int fchmodat2(int dirfd, const char *path, mode_t mode,
+		 *               unsigned int flags) -- Linux 6.6.
+		 *
+		 * glibc >= 2.39 implements lchmod(3) and
+		 * fchmodat(..., AT_SYMLINK_NOFOLLOW) with it. Unknown to
+		 * PRoot, it used to reach the kernel with the untranslated
+		 * guest path: an absolute path then named a host file
+		 * (ENOENT, or a wrong file), so libarchive (pacman, bsdtar)
+		 * reported "Can't set permissions" on every symlink and a
+		 * no-follow chmod of a regular file silently did nothing.
+		 *
+		 * A call with a path never reaches the kernel as it is: it
+		 * is expressed with syscalls PRoot already translates, with
+		 * the kernel's semantics:
+		 *   flags 0                      -> fchmodat(dirfd, path, mode)
+		 *   AT_SYMLINK_NOFOLLOW, symlink -> -EOPNOTSUPP, as Linux
+		 *   AT_SYMLINK_NOFOLLOW, other   -> fchmodat on the translated
+		 *                                   path, which is not a link
+		 *   AT_EMPTY_PATH and ""         -> unchanged: no path to
+		 *                                   translate, so the kernel
+		 *                                   acts on the descriptor
+		 *   any other flag               -> -EINVAL
+		 * fchmod() is not a substitute for the empty-path form: it
+		 * fails with EBADF on an O_PATH descriptor, which is how
+		 * systemd-tmpfiles changes modes (fchmod_opath). A kernel
+		 * older than 6.6 answers ENOSYS, as it does natively, and
+		 * callers fall back to /proc/self/fd.
+		 * The symlink case is decided on the translated host path,
+		 * after extensions (link2symlink) resolved it, so a faked
+		 * hard link is a regular file here as everywhere else.  */
+		char translated[PATH_MAX];
+		struct stat statl;
+		word_t chmod_flags = peek_reg(tracee, CURRENT, SYSARG_4);
+
+		if ((chmod_flags & ~((word_t) (AT_SYMLINK_NOFOLLOW | AT_EMPTY_PATH))) != 0) {
+			status = -EINVAL;
+			break;
+		}
+
+		dirfd = peek_reg(tracee, CURRENT, SYSARG_1);
+		status = get_sysarg_path(tracee, path, SYSARG_2);
+		if (status < 0)
+			break;
+
+		if (path[0] == '\0') {
+			status = (chmod_flags & AT_EMPTY_PATH) == 0 ? -ENOENT : 0;
+			break;
+		}
+
+		status = translate_path(tracee, translated, dirfd, path,
+					(chmod_flags & AT_SYMLINK_NOFOLLOW) == 0);
+		if (status < 0)
+			break;
+
+		if ((chmod_flags & AT_SYMLINK_NOFOLLOW) != 0
+		    && lstat(translated, &statl) == 0
+		    && S_ISLNK(statl.st_mode)) {
+			status = -EOPNOTSUPP;
+			break;
+		}
+
+		status = set_sysarg_path(tracee, translated, SYSARG_2);
+		if (status < 0)
+			break;
+
+		/* fchmodat(int dirfd, const char *path, mode_t mode): the
+		 * translated path is absolute, so dirfd no longer matters.  */
+		set_sysnum(tracee, PR_fchmodat);
+		poke_reg(tracee, SYSARG_4, 0);
+		status = 0;
+		break;
+	}
+
 	case PR_inotify_add_watch:
 		flags = peek_reg(tracee, CURRENT, SYSARG_3);
 
