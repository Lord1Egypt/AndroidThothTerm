<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ system splash; the regular activity theme continues afterward. -->
    <style name="AppTheme.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="windowActionModeOverlay">true</item>
        <item name="actionModeBackground">?attr/colorPrimary</item>
        <item name="android:windowSplashScreenBackground">@color/brand_midnight</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_splash_emblem</item>
        <item name="android:windowSplashScreenAnimationDuration">200</item>
    </style>

    <style name="AppTheme.Light.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="windowActionModeOverlay">true</item>
        <item name="actionModeBackground">?attr/colorPrimary</item>
        <item name="android:windowSplashScreenBackground">@color/brand_midnight</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_splash_emblem</item>
        <item name="android:windowSplashScreenAnimationDuration">200</item>
    </style>

    <style name="AppTheme.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="windowActionModeOverlay">true</item>
        <item name="actionModeBackground">?attr/colorPrimary</item>
        <item name="android:windowSplashScreenBackground">@color/brand_midnight</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_splash_emblem</item>
        <item name="android:windowSplashScreenAnimationDuration">200</item>
    </style>

    <style name="AppTheme.Amoled.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="windowActionModeOverlay">true</item>
        <item name="actionModeBackground">?attr/colorPrimary</item>
        <item name="android:windowSplashScreenBackground">@android:color/black</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_splash_emblem</item>
        <item name="android:windowSplashScreenAnimationDuration">200</item>
    </style>
</resources>
