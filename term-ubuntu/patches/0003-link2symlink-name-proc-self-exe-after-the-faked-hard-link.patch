 /**
+ * Name "/proc/self/exe" after the faked hard link @tracee executed.
+ *
+ * On Linux, /proc/self/exe of a program started through a hard link is
+ * that link's own path.  A faked hard link is a symlink chain into the
+ * l2s directory, so PRoot would otherwise report the l2s backing file,
+ * a name no tracee ever used.  Multicall binaries installed as hard links
+ * check that name -- Ubuntu's rust-coreutils refuses to run when
+ * basename(/proc/self/exe) differs from the utility requested -- so after
+ * any dpkg upgrade that re-creates such links every utility breaks.
+ *
+ * Walk the path the tracee passed to execve(2): follow ordinary symlinks,
+ * as the kernel does, and stop at the faked hard link that leads to the
+ * executed file.  Nothing changes when no faked hard link is involved.
+ */
+static void name_exe_after_faked_link(Tracee *tracee)
+{
+	char guest[PATH_MAX];
+	char host[PATH_MAX];
+	char final[PATH_MAX];
+	char target[PATH_MAX];
+	const char *raw;
+	ssize_t length;
+	int status;
+	int i;
+
+	if (tracee->load_info == NULL || tracee->host_exe == NULL || tracee->new_exe == NULL)
+		return;
+	if (!is_l2s_file(tracee->host_exe))
+		return;
+
+	raw = tracee->load_info->raw_path;
+	if (raw == NULL || strlen(raw) >= PATH_MAX)
+		return;
+	strcpy(guest, raw);
+
+	for (i = 0; i < 40; i++) { /* MAXSYMLINKS */
+		char *slash = strrchr(guest, '/');
+		const char *base = (slash == NULL ? guest : slash + 1);
+
+		if (base[0] == '\0' || strcmp(base, ".") == 0 || strcmp(base, "..") == 0)
+			return;
+
+		/* Translate only the directory: translated_path() above swaps
+		 * a faked hard link for the file it leads to, which would hide
+		 * the very link this is looking for.  A directory is never a
+		 * faked hard link.  */
+		if (slash == NULL) {
+			status = translate_path(tracee, host, AT_FDCWD, ".", true);
+		}
+		else if (slash == guest) {
+			status = translate_path(tracee, host, AT_FDCWD, "/", true);
+		}
+		else {
+			*slash = '\0';
+			status = translate_path(tracee, host, AT_FDCWD, guest, true);
+			*slash = '/';
+		}
+		if (status < 0)
+			return;
+		if (strlen(host) + 1 + strlen(base) >= PATH_MAX)
+			return;
+		if (strcmp(host, "/") != 0)
+			strcat(host, "/");
+		strcat(host, base);
+
+		if (resolve_faked_hard_link(host, final) == 0) {
+			if (strcmp(final, tracee->host_exe) != 0)
+				return;
+			status = detranslate_path(tracee, host, NULL);
+			if (status < 0)
+				return;
+			talloc_unlink(tracee, tracee->new_exe);
+			tracee->new_exe = talloc_strdup(tracee, host);
+			return;
+		}
+
+		/* An ordinary symlink: continue with its target, a guest path. */
+		length = readlink(host, target, PATH_MAX - 1);
+		if (length <= 0)
+			return;
+		target[length] = '\0';
+
+		if (target[0] == '/') {
+			strcpy(guest, target);
+		}
+		else {
+			char *slash = strrchr(guest, '/');
+			size_t dir = (slash == NULL ? 0 : (size_t) (slash - guest) + 1);
+			if (dir + strlen(target) >= PATH_MAX)
+				return;
+			strcpy(guest + dir, target);
+		}
+	}
+}
+
