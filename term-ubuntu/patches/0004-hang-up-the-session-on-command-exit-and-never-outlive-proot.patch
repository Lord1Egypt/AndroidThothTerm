+/**
+ * What a terminal hangup does when the window's command exits: SIGHUP,
+ * then SIGCONT so stopped jobs act on it, to every tracee still in
+ * proot's session -- proot is the session leader the terminal was given
+ * to.  A process that ignores SIGHUP (nohup) or left the session (setsid)
+ * keeps running, and proot keeps tracing it.  proot then lets go of the
+ * terminal, so it is released as soon as the survivors do not hold it.
+ */
+void hangup_all_tracees(const Tracee *exited)
+{
+	Tracee *tracee;
+	pid_t session = getsid(0);
+	int null_fd;
+
+	LIST_FOREACH(tracee, &tracees, link) {
+		if (tracee == exited || tracee->terminated)
+			continue;
+		if (getsid(tracee->pid) != session)
+			continue;
+		kill(tracee->pid, SIGHUP);
+		kill(tracee->pid, SIGCONT);
+	}
+
+	null_fd = open("/dev/null", O_RDWR);
+	if (null_fd >= 0) {
+		(void) dup2(null_fd, STDIN_FILENO);
+		(void) dup2(null_fd, STDOUT_FILENO);
+		(void) dup2(null_fd, STDERR_FILENO);
+		if (null_fd > STDERR_FILENO)
+			(void) close(null_fd);
+	}
+}
+
 Tracees *get_tracees_list_head() {
 	return &tracees;
 }
