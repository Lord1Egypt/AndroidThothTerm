+static int sysvipc_shm_do_allocate(size_t size, int shmid);
+
+/*
+ * Without libandroid-shmem sharing, segments are kept by this proot process
+ * itself instead of a forked "proot --shm-helper": no extra process per
+ * container, nothing left running or listening once proot is gone, and the
+ * memory is released with proot's descriptors.  Segments come from
+ * memfd_create(2), since apps targeting API 29+ cannot open /dev/ashmem.
+ */
+static int sysvipc_shm_local_alloc(size_t size, int shmid)
+{
+	int fd = syscall(__NR_memfd_create, "sysvshm", 1 /* MFD_CLOEXEC */);
+	if (fd < 0) {
+		fd = sysvipc_shm_do_allocate(size, shmid);
+		if (fd >= 0)
+			fcntl(fd, F_SETFD, FD_CLOEXEC);
+		return fd;
+	}
+	if (ftruncate(fd, size) < 0) {
+		close(fd);
+		return -ENOSPC;
+	}
+	return fd;
+}
+
+/* The listening socket of the one shmat in flight (attaches are serialized),
+ * bound under PROOT_TMP_DIR and removed as soon as the tracee is served.  */
+static int sysvipc_shm_listen_fd = -1;
+
+static void sysvipc_shm_local_unlisten(void)
+{
+	if (sysvipc_shm_listen_fd < 0)
+		return;
+	unlink(sysvipc_shm_helper_addr.sun_path);
+	close(sysvipc_shm_listen_fd);
+	sysvipc_shm_listen_fd = -1;
+}
+
+static int sysvipc_shm_local_listen(void)
+{
+	assert(sysvipc_shm_listen_fd < 0);
+	int fd = socket(AF_UNIX, SOCK_SEQPACKET | SOCK_CLOEXEC | SOCK_NONBLOCK, 0);
+	if (fd < 0)
+		return -errno;
+	for (int i = 0; i < 64; i++) {
+		char path[PATH_MAX];
+		bool fits = make_random_temp_name(path, sizeof(path), "prootshm") == 0
+			&& strlen(path) < sizeof(sysvipc_shm_helper_addr.sun_path);
+		if (fits) {
+			memset(&sysvipc_shm_helper_addr, 0, sizeof(sysvipc_shm_helper_addr));
+			sysvipc_shm_helper_addr.sun_family = AF_UNIX;
+			strcpy(sysvipc_shm_helper_addr.sun_path, path);
+		}
+		if (!fits)
+			break;
+		if (bind(fd, (struct sockaddr *) &sysvipc_shm_helper_addr, sizeof(sysvipc_shm_helper_addr)) == 0) {
+			if (listen(fd, 1) == 0) {
+				sysvipc_shm_listen_fd = fd;
+				return 0;
+			}
+			unlink(sysvipc_shm_helper_addr.sun_path);
+			break;
+		}
+		if (errno != EADDRINUSE)
+			break;
+	}
+	close(fd);
+	return -ENOMEM;
+}
+
+static pid_t sysvipc_shm_tgid(pid_t tid)
+{
+	char path[32], line[64];
+	pid_t tgid = tid;
+	snprintf(path, sizeof(path), "/proc/%d/status", tid);
+	FILE *status = fopen(path, "re");
+	if (status == NULL)
+		return tid;
+	while (fgets(line, sizeof(line), status) != NULL)
+		if (sscanf(line, "Tgid: %d", &tgid) == 1)
+			break;
+	fclose(status);
+	return tgid;
+}
+
+/* Send @mem_fd to the tracee that has just connected.  A connection from any
+ * other process is dropped: the segment is only ever handed to its tracee.  */
+static int sysvipc_shm_local_distribute(Tracee *tracee, int mem_fd)
+{
+	pid_t tgid = sysvipc_shm_tgid(tracee->pid);
+	int status = -ECONNREFUSED;
+	for (;;) {
+		int conn = accept4(sysvipc_shm_listen_fd, NULL, NULL, SOCK_CLOEXEC);
+		if (conn < 0)
+			break;
+		struct ucred cred;
+		socklen_t cred_len = sizeof(cred);
+		if (getsockopt(conn, SOL_SOCKET, SO_PEERCRED, &cred, &cred_len) == 0 && cred.pid == tgid) {
+			char nothing = '!';
+			struct iovec iov = { .iov_base = &nothing, .iov_len = 1 };
+			union {
+				struct cmsghdr align;
+				char buf[CMSG_SPACE(sizeof(int))];
+			} control;
+			memset(&control, 0, sizeof(control));
+			struct msghdr message = {
+				.msg_iov = &iov,
+				.msg_iovlen = 1,
+				.msg_control = control.buf,
+				.msg_controllen = sizeof(control.buf),
+			};
+			struct cmsghdr *cmsg = CMSG_FIRSTHDR(&message);
+			cmsg->cmsg_level = SOL_SOCKET;
+			cmsg->cmsg_type = SCM_RIGHTS;
+			cmsg->cmsg_len = CMSG_LEN(sizeof(int));
+			memcpy(CMSG_DATA(cmsg), &mem_fd, sizeof(int));
+			status = sendmsg(conn, &message, MSG_DONTWAIT | MSG_NOSIGNAL) == 1 ? 0 : -errno;
+			close(conn);
+			break;
+		}
+		close(conn);
+	}
+	sysvipc_shm_local_unlisten();
+	return status;
+}
